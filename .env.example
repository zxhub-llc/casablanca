# WordPress/WooCommerce Site URL
WORDPRESS_URL="https://your-wordpress-site.com"
WORDPRESS_HOSTNAME="your-wordpress-site.com"

# The URL of the GraphQL endpoint (without /graphql)
GRAPHQL_PATH="graphql"

# Public WordPress URL (for client-side links like My Account)
NEXT_PUBLIC_WORDPRESS_URL="https://your-wordpress-site.com"

# Webhook secret for cache revalidation
# Generate with: openssl rand -base64 32
WORDPRESS_WEBHOOK_SECRET="your-secret-key-here"

# WooCommerce REST API credentials
# Generate in: WooCommerce > Settings > Advanced > REST API
WC_CONSUMER_KEY="ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WC_CONSUMER_SECRET="cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Note: Payment processing (Stripe, PayPal, etc.) is configured in WooCommerce admin.
# Users are redirected to WooCommerce checkout for payment.

#Resend
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=

ZX_INTERNAL_SECRET=
COMPANY_WHATSAPP_NUMBER=